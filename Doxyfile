PROJECT_NAME           = "python-doxygen"
PROJECT_BRIEF          = "Reference documentation for python-doxygen"
OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
INPUT                  = tests/python/fixtures/00-doxygen-experiment.py
RECURSIVE              = NO
FILE_PATTERNS          = *.py
FILTER_PATTERNS        = *.py="$(AWK_BIN) -f $(DOXYGEN_PYTHON_FILTER) --"
FILTER_SOURCE_FILES    = YES
EXTRACT_ALL            = NO
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
