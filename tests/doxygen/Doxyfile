PROJECT_NAME           = "python-doxygen integration"
OUTPUT_DIRECTORY       = tests/doxygen/out
CREATE_SUBDIRS         = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
INPUT                  = tests/python/fixtures/00-doxygen-experiment.py \
                         tests/python/fixtures/20-doxygen-standards-conformance.py \
                         tests/doxygen/representation-candidate.py
RECURSIVE              = NO
FILE_PATTERNS          = *.py
FILTER_PATTERNS        = *.py="$(AWK_BIN) -f $(DOXYGEN_PYTHON_FILTER) --"
FILTER_SOURCE_FILES    = YES
EXTRACT_ALL            = NO
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
